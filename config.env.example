# ============================================================
#  config.env.example
#  Copy this file to config.env and fill in your values.
#  Never commit config.env — it contains secret keys.
# ============================================================

# ----------------------------------------------------------
# Figma API (required for live mode)
# Get your token at: https://www.figma.com/developers/api#access-tokens
# ----------------------------------------------------------
FIGMA_ACCESS_TOKEN=figd_YOUR_TOKEN_HERE

# ----------------------------------------------------------
# LLM API keys — set the one matching your chosen --model
# ----------------------------------------------------------

# Anthropic / Claude  (for --model claude-*)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# OpenAI / GPT  (for --model gpt-*)
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# Google Vertex AI / Gemini  (for --model gemini-*)
# Point to a service-account JSON file with Vertex AI access
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
LOG_LEVEL=INFO
